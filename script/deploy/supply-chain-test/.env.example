# 镜像必须使用可追溯的 Git SHA 标签；不要使用 latest。
SUPPLY_CHAIN_IMAGE=aifuli/supply-chain-server:replace-with-git-sha
# JVM 默认使用镜像内的 6 GiB 基线；特殊服务器必须完整覆盖全部参数。
# JAVA_OPTS=-Xms6g -Xmx6g -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
SPRING_PROFILES_ACTIVE=test

# Nacos 公共、Config 与 Discovery 配置；填入可由 pro143 访问的 VPC 私网地址，用户名/密码仅写入 0600 .env。
SPRING_CLOUD_NACOS_SERVER_ADDR=replace-with-vpc-private-nacos-host:8848
SPRING_CLOUD_NACOS_USERNAME=
SPRING_CLOUD_NACOS_PASSWORD=
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR=replace-with-vpc-private-nacos-host:8848
SPRING_CLOUD_NACOS_CONFIG_USERNAME=
SPRING_CLOUD_NACOS_CONFIG_PASSWORD=
SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=aifuli-mall-test
SPRING_CLOUD_NACOS_CONFIG_GROUP=test
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=replace-with-vpc-private-nacos-host:8848
SPRING_CLOUD_NACOS_DISCOVERY_USERNAME=
SPRING_CLOUD_NACOS_DISCOVERY_PASSWORD=
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=aifuli-mall-test
SPRING_CLOUD_NACOS_DISCOVERY_GROUP=test
SPRING_CLOUD_NACOS_DISCOVERY_IP=172.19.64.105
SPRING_CLOUD_NACOS_DISCOVERY_PORT=58190

# 供应链独立数据源；填入 pro143 可访问的 RDS 私网主机，并以 VERIFY_IDENTITY 校验 TLS 证书和主机名。
AIFULI_SUPPLY_CHAIN_DATASOURCE_URL=jdbc:mysql://replace-with-rds-private-host:3306/supply-chain-test?sslMode=VERIFY_IDENTITY&characterEncoding=utf8
AIFULI_SUPPLY_CHAIN_DATASOURCE_USERNAME=
AIFULI_SUPPLY_CHAIN_DATASOURCE_PASSWORD=
AIFULI_SUPPLY_CHAIN_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# 项目认证在测试环境也失败关闭；master key 必须是单独生成的 32 字节 Base64 值。
AIFULI_SUPPLY_CHAIN_AUTH_ENABLED=true
AIFULI_SUPPLY_CHAIN_AUTH_MASTER_KEY=

# 直充限频身份摘要密钥；必须为单独生成的 32 字节 Base64 值。
AIFULI_SUPPLY_CHAIN_RECHARGE_FREQUENCY_IDENTITY_KEY=

# 环境变量优先于 Nacos，是实际生效层；pro143 为测试库唯一消费者，开发实例连接同库时须自行关闭。
# 见 docs/superpowers/specs/2026-10-12-supply-chain-test-timer-outbox-enable-design.md#2-前提核对。
AIFULI_SUPPLY_CHAIN_TIMER_ENABLED=true
AIFULI_SUPPLY_CHAIN_OUTBOX_ENABLED=true

# 旅通机密仅放 pro143 .env；私钥必须是移除 PEM 包装和所有空白后的单行 PKCS#8 Base64。
AIFULI_SUPPLY_CHAIN_INSTORE_RTMART_ENABLED=true
AIFULI_SUPPLY_CHAIN_INSTORE_RTMART_APP_KEY=
AIFULI_SUPPLY_CHAIN_INSTORE_RTMART_PRIVATE_KEY=

AIFULI_SUPPLY_CHAIN_OPENAPI_ENABLED=false
