# supplyhub 测试栈环境变量模板。复制为服务器 /data/aifuli-test/supplyhub/.env 后填密钥，权限 0600。
# 设计见 docs/superpowers/specs/2026-09-04-supplyhub-test-docker-compose-design.md
# 不要把填好密钥的 .env 提交到 Git。

SPRING_PROFILES_ACTIVE=test
TZ=Asia/Shanghai

# 镜像标签由 deploy-pro143.sh 写入为 <git短SHA>-amd64。
# 2026-09-07：移除 PAY/ERP/MALL/STATISTICS，supplyhub 栈只部署 gateway/system/infra/member。
GATEWAY_IMAGE=aifuli/gateway-server:replace-with-git-sha-amd64
SYSTEM_IMAGE=aifuli/system-server:replace-with-git-sha-amd64
INFRA_IMAGE=aifuli/infra-server:replace-with-git-sha-amd64
MEMBER_IMAGE=aifuli/member-server:replace-with-git-sha-amd64

GATEWAY_JAVA_OPTS=-Xms512m -Xmx512m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -Duser.home=/data/aifuli-test/supplyhub
SYSTEM_JAVA_OPTS=-Xms512m -Xmx512m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -Duser.home=/data/aifuli-test/supplyhub
INFRA_JAVA_OPTS=-Xms512m -Xmx512m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -Duser.home=/data/aifuli-test/supplyhub
MEMBER_JAVA_OPTS=-Xms512m -Xmx512m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -Duser.home=/data/aifuli-test/supplyhub

SPRING_CLOUD_NACOS_SERVER_ADDR=replace-with-nacos-host:8848
SPRING_CLOUD_NACOS_USERNAME=
SPRING_CLOUD_NACOS_PASSWORD=
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR=replace-with-nacos-host:8848
SPRING_CLOUD_NACOS_CONFIG_USERNAME=
SPRING_CLOUD_NACOS_CONFIG_PASSWORD=
SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=aifuli-supplyhub-test
SPRING_CLOUD_NACOS_CONFIG_GROUP=test
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=replace-with-nacos-host:8848
SPRING_CLOUD_NACOS_DISCOVERY_USERNAME=
SPRING_CLOUD_NACOS_DISCOVERY_PASSWORD=
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=aifuli-supplyhub-test
SPRING_CLOUD_NACOS_DISCOVERY_GROUP=test
SPRING_CLOUD_NACOS_DISCOVERY_IP=172.19.64.105

# 指向 pro143 现有供应链容器；不要写进 docker-compose.yml。
AIFULI_GATEWAY_SUPPLY_CHAIN_URI=http://127.0.0.1:58190
