<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aifuli.module.supplychain.border.fulfillment.dal.mysql.RechargeFrequencyQueueMapper">
    <!-- 行锁查询仅针对已存在的业务行；统一先锁控制行。设计见 docs/superpowers/specs/2026-09-30-direct-recharge-mobile-spu-frequency-design.md#3-持久化模型与不变量 -->
